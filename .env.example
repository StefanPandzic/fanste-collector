# Fanste Collector — environment variables
#
# Copy to `.env.local` at the repository root (never commit it) and fill in the values for your dev environment.
# The web and desktop apps load the root env files themselves (see `apps/web/next.config.ts`,
# `apps/desktop/electron.vite.config.ts`).
# `NEXT_PUBLIC_*` variables are exposed to the browser; everything else is server-only.
# `DESKTOP_*` variables are inlined into the desktop app at build time — never put secrets in them.
# Each variable is introduced by the task in brackets, which documents how to obtain it.

# --- Supabase (FC-04) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase CLI only (linking, `db push`, type generation)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Desktop app (FC-03) ------------------------------------------------------
# Web app loaded by the desktop window. Defaults to http://localhost:3000 (the dev server).
# Must be https:// except for localhost. Set to the production URL when packaging (FC-29).
DESKTOP_WEB_URL=

# --- Metadata providers (server-only, used by the API gateway) ----------------
# TMDB — Movies & TV (FC-09)
TMDB_API_READ_TOKEN=
# Discogs — Physical music (FC-10)
DISCOGS_TOKEN=
# IGDB via Twitch — Video games (FC-11)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# BoardGameGeek — Board games (FC-12)
BGG_API_TOKEN=
